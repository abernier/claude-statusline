#!/usr/bin/env bash
# `date +%s` is the statusline's only clock: it drives every ↻ countdown and
# the elapsed-time half of the stacked bars. The suite freezes it, so a
# rendering recorded today still reads "↻2h0m" a year from now.
#
# The other call is `date -d` / `date -j`, which parses the Fable resets_at out
# of the usage payload. That one is pure — same string in, same epoch out — and
# it is worth exercising for real, since it is the one place the script has to
# straddle GNU and BSD date. So it goes to the real binary.
if [[ $# == 1 && $1 == '+%s' ]]; then
  printf '%s\n' "$STATUSLINE_TEST_NOW"
  exit 0
fi
PATH=$STATUSLINE_TEST_PATH exec date "$@"
