#!/usr/bin/env bash
# statusline.sh asks git four questions per render. Each answer comes from a
# file in the fixture, so a fixture describes a working tree — a branch name, a
# porcelain status, a numstat — without anyone having to build one on disk.
#
# What is under test is the awk that reads those bytes, and it reads them the
# same either way; what a canned stdout removes is the git version, the locale,
# and whatever happens to be uncommitted in the checkout the suite runs from.
d=${STATUSLINE_TEST_GIT:-}

emit() {
  [[ -f "$d/$1" ]] && cat "$d/$1"
  return 0
}

# the -C <dir> that every call passes
[[ ${1:-} == -C ]] && shift 2

case "$*" in
  'branch --show-current')        emit branch ;;
  'status --porcelain')           emit status ;;
  'diff HEAD --numstat')          emit numstat ;;
  # The worktree glyph turns on a commondir file next to this path; the runner
  # creates one for a fixture that asks for it.
  'rev-parse --absolute-git-dir') printf '%s\n' "$STATUSLINE_TEST_GITDIR" ;;
  # Anything else is a call no fixture can answer. It goes to a log the runner
  # reads, because stderr and the exit code both vanish here: every git call in
  # statusline.sh carries its own `2>/dev/null` and is wrapped in a command
  # substitution that discards the status. Without the log, a new git call would
  # be caught only if it happened to change the rendering.
  *)
    echo "statusline.test/bin/git: unhandled call: git $*" >&2
    [[ -n ${STATUSLINE_TEST_GIT_LOG:-} ]] && echo "git $*" >> "$STATUSLINE_TEST_GIT_LOG"
    exit 1
    ;;
esac
exit 0
