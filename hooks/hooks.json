{
  "description": "Keep the installed statusline in step with the plugin's copy.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
